diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 1ff690504..830a2b98e 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3121,6 +3121,19 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }
 
+// xllama (patches/0003-cpu-op-timing.patch): per-op CPU time of a decode, from
+// the LocalState knob cpu-op-timing.txt. Only thread 0 (the calling thread)
+// times and writes, so workers never race on these; xllama reads and zeroes
+// them after llama_decode, while the pool is idle. 0 keeps upstream behaviour
+// (thread 0 reads this global once per graph; numerics untouched).
+#if defined(_WIN32)
+int     xllama_ggml_cpu_op_timing = 0;
+int64_t xllama_ggml_cpu_op_us[GGML_OP_COUNT];
+int64_t xllama_ggml_cpu_op_n[GGML_OP_COUNT];
+int64_t xllama_ggml_cpu_barrier_us = 0;
+int64_t xllama_ggml_cpu_graphs = 0;
+#endif
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3149,6 +3162,13 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+#if defined(_WIN32)
+    const bool xllama_time = state->ith == 0 && xllama_ggml_cpu_op_timing;
+    if (xllama_time) {
+        ++xllama_ggml_cpu_graphs;
+    }
+#endif
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3163,12 +3183,22 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
+#if defined(_WIN32)
+        // A fused group (RMS_NORM + MUL) is charged to its first node's op.
+        const int64_t xllama_t0 = xllama_time ? ggml_time_us() : 0;
+#endif
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
         if (n_fused > 0) {
             node_n += n_fused;
         } else {
             ggml_compute_forward(&params, node);
         }
+#if defined(_WIN32)
+        if (xllama_time) {
+            xllama_ggml_cpu_op_us[node->op] += ggml_time_us() - xllama_t0;
+            ++xllama_ggml_cpu_op_n[node->op];
+        }
+#endif
 
         if (state->ith == 0 && cplan->abort_callback &&
                 cplan->abort_callback(cplan->abort_callback_data)) {
@@ -3177,7 +3207,15 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
         }
 
         if (node_n + 1 < cgraph->n_nodes) {
+#if defined(_WIN32)
+            const int64_t xllama_tb = xllama_time ? ggml_time_us() : 0;
+#endif
             ggml_barrier(state->threadpool);
+#if defined(_WIN32)
+            if (xllama_time) {
+                xllama_ggml_cpu_barrier_us += ggml_time_us() - xllama_tb;
+            }
+#endif
         }
     }
 
@@ -3187,7 +3225,15 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-done cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+#if defined(_WIN32)
+    const int64_t xllama_tf = xllama_time ? ggml_time_us() : 0;
+#endif
     ggml_barrier(state->threadpool);
+#if defined(_WIN32)
+    if (xllama_time) {
+        xllama_ggml_cpu_barrier_us += ggml_time_us() - xllama_tf;
+    }
+#endif
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
